---
interface Props {
  id: string;
  title: string;
  duration: string;
  location: string;
  price: string;
  image: string;
  description: string;
  href: string;
  fromPrice: string;
  btnText: string;
}

const {
  id,
  title,
  duration,
  location,
  price,
  image,
  description,
  href,
  fromPrice,
  btnText,
} = Astro.props;
---

<article class="w-full snap-center group cursor-pointer">
  <div
    class="relative w-full h-100 sm:h-115 rounded-2xl overflow-hidden border border-border/80 hover:border-primary/80 transition-all duration-500 flex flex-col justify-between p-4 sm:p-6 bg-card"
  >
    <div class="absolute inset-0 z-0">
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
      />
      <div
        class="absolute inset-0 bg-linear-to-t from-black via-black/50 to-black/30 group-hover:via-black/60 transition-colors"
      >
      </div>
    </div>

    <div class="relative z-10 flex items-center justify-between gap-1.5">
      <span
        class="px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-black/75 backdrop-blur-md border border-white/20 text-white font-body text-xs sm:text-sm font-semibold flex items-center gap-1.5 shadow-md"
      >
        <svg
          class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-primary"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        {location}
      </span>

      <span
        class="px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-black/75 backdrop-blur-md border border-white/20 text-white font-body text-xs sm:text-sm font-semibold flex items-center gap-1.5 shadow-md"
      >
        <svg
          class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-primary"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        {duration}
      </span>
    </div>

    <div class="relative z-10 space-y-2.5 pt-4">
      <h3 class="font-heading text-2xl text-primary line-clamp-2">
        {title}
      </h3>

      <p class="line-clamp-2 text-base">
        {description}
      </p>
      <div
        class="pt-3 border-t border-white/40 flex items-center justify-between"
      >
        <div>
          <span class="block sm:text-xs tracking-wider font-medium uppercase">
            {fromPrice}
          </span>
          <div class="flex items-baseline gap-1">
            <span class="font-heading text-xl sm:text-3xl text-primary">
              ${price}
            </span>
            <span class="text-xs sm:text-xs font-medium"> USD </span>
          </div>
        </div>
        <a
          href={href}
          class="bg-primary hover:bg-primary/90 text-primary-foreground font-heading text-xs sm:text-sm font-bold tracking-wider px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl transition-all duration-300 transform group-hover:-translate-y-0.5 shadow-md shadow-primary/30 flex items-center gap-1.5"
        >
          <span>{btnText}</span>
          <svg
            class="w-3.5 h-3.5 sm:w-4 sm:h-4 transition-transform duration-200 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>
