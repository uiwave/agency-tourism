---
interface Props {
  title: string;
  tagline: string;
  category: string;
  duration: string;
  image: string;
  isPopular?: boolean;
  href: string;
  exploreText: string;
  recommendedText: string;
  popularText: string;
}

const { title, tagline, category, duration, image, isPopular, href, exploreText, recommendedText, popularText } = Astro.props;
---

<a
  href={href}
  class="group relative h-[420px] sm:h-[480px] w-full rounded-3xl overflow-hidden border border-white/20 shadow-2xl flex flex-col justify-between p-6 sm:p-8 transition-all duration-500 hover:scale-[1.01] hover:border-white/40"
>
  <!-- Imagen de fondo con Zoom al hacer Hover -->
  <img
    src={image}
    alt={title}
    class="absolute inset-0 w-full h-full object-cover object-center brightness-90 group-hover:scale-110 transition-transform duration-700 ease-out z-0"
  />

  <!-- Capa Gradiente para asegurar lectura perfecta -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/30 z-10"></div>

  <!-- PARTE SUPERIOR DE LA TARJETA: Badges -->
  <div class="relative z-20 flex items-center justify-between gap-2">
    <span class="px-3.5 py-1.5 rounded-full bg-black/40 backdrop-blur-md border border-white/20 text-xs font-semibold text-white/90">
      {category}
    </span>

    {isPopular && (
      <span class="px-3.5 py-1.5 rounded-full bg-white text-black font-bold text-xs shadow-lg">
        {popularText}
      </span>
    )}
  </div>

  <!-- PARTE INFERIOR DE LA TARJETA: Información y Acción -->
  <div class="relative z-20 space-y-4">
    <div class="space-y-1">
      <span class="text-xs font-semibold tracking-wider text-teal-300 uppercase">
        {recommendedText} {duration}
      </span>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight drop-shadow">
        {title}
      </h3>
      <p class="text-sm sm:text-base text-gray-200 font-normal drop-shadow-sm">
        {tagline}
      </p>
    </div>

    <!-- Botón flotante al hacer Hover -->
    <div class="pt-2 flex items-center gap-2 text-sm font-bold text-white group-hover:translate-x-1 transition-transform duration-300">
      <span>{exploreText}</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </div>
  </div>
</a>
