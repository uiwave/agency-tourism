---
interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  class?: string;
}

const {
  title,
  subtitle,
  centered = true,
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    centered ? "text-center max-w-3xl mx-auto" : "",
    "space-y-4",
    className,
  ]}
>
  <h2 class="uw-heading-sm text-primary">
    {title}
  </h2>

  {subtitle && <p>{subtitle}</p>}
</div>
