---
const currentLang = Astro.currentLocale || "es";
const currentPath = Astro.url.pathname;

const languages = [
  { code: "es", label: "ES", name: "Español" },
  { code: "en", label: "EN", name: "English" },
  { code: "pt", label: "PT", name: "Português" },
];

function getLocalePath(langCode: string) {
  if (currentPath.match(/\/(es|en|pt)(\/|$)/)) {
    return currentPath.replace(/\/(es|en|pt)/, `/${langCode}`);
  }
  return `/${langCode}${currentPath.startsWith('/') ? '' : '/'}${currentPath}`;
}

const activeLanguage = languages.find((lang) => lang.code === currentLang) || languages[0];
---

<div class="relative inline-block text-left lang-selector-container">
  <!-- Botón con tamaño adecuado, contraste claro y alineación perfecta -->
  <button
    type="button"
    class="lang-selector-btn inline-flex items-center gap-2.5 px-5 py-3 rounded-full text-sm font-semibold text-white bg-black/40 hover:bg-black/60 backdrop-blur-md border border-white/20 transition-all duration-200 cursor-pointer focus:outline-none shadow-md"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <!-- Icono Globo más visible -->
    <svg class="w-4 h-4 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
    </svg>
    
    <span class="tracking-wide">{activeLanguage.label}</span>

    <!-- Flecha -->
    <svg class="w-4 h-4 text-white/80 lang-arrow transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <!-- Menú desplegable con textos grandes, claros y con buen espacio de toque -->
  <div 
    class="lang-menu hidden absolute right-0 mt-3 w-44 rounded-2xl bg-black/90 backdrop-blur-xl border border-white/20 shadow-2xl z-50 overflow-hidden p-2"
  >
    {
      languages.map((lang) => {
        const isActive = lang.code === currentLang;
        return (
          <a
            href={getLocalePath(lang.code)}
            class:list={[
              "flex items-center justify-between px-4 py-3 text-sm font-medium rounded-xl transition-all duration-150",
              isActive
                ? "bg-white text-black font-bold shadow-md"
                : "text-white hover:bg-white/15",
            ]}
          >
            <span>{lang.name}</span>
            <span class="text-xs font-semibold opacity-70 uppercase tracking-wider">{lang.code}</span>
          </a>
        );
      })
    }
  </div>
</div>

<script>
  document.querySelectorAll('.lang-selector-container').forEach((container) => {
    const btn = container.querySelector('.lang-selector-btn');
    const menu = container.querySelector('.lang-menu');
    const arrow = container.querySelector('.lang-arrow');

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !menu?.classList.contains('hidden');

      document.querySelectorAll('.lang-menu').forEach((m) => m.classList.add('hidden'));
      document.querySelectorAll('.lang-arrow').forEach((a) => a.classList.remove('rotate-180'));

      if (!isOpen) {
        menu?.classList.remove('hidden');
        arrow?.classList.add('rotate-180');
      }
    });
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('.lang-menu').forEach((m) => m.classList.add('hidden'));
    document.querySelectorAll('.lang-arrow').forEach((a) => a.classList.remove('rotate-180'));
  });
</script>