---
import Attend from "@/assets/icons/attend.svg";

const currentLang = Astro.currentLocale || "es";

const translations: Record<string, any> = {
  es: {
    tagline: "Descubre las mejores experiencias turísticas en los destinos más increíbles del Perú.",
    quickLinks: "Navegación",
    destinations: "Destinos",
    about: "Sobre Nosotros",
    contact: "Contacto",
    legal: "Información Legal",
    terms: "Términos y Condiciones",
    privacy: "Política de Privacidad",
    cookies: "Política de Cookies",
    claimBook: "Libro de Reclamaciones",
    contactTitle: "Contacto y Reservas",
    address: "Av. El Sol 123, Cusco - Perú",
    phone: "+51 123 456 789",
    email: "reservas@travelik.com",
    hours: "Lun - Sáb: 8:00 AM - 8:00 PM",
    rights: "Todos los derechos reservados.",
  },
  en: {
    tagline: "Discover the best travel experiences in Peru's most incredible destinations.",
    quickLinks: "Navigation",
    destinations: "Destinations",
    about: "About Us",
    contact: "Contact",
    legal: "Legal Info",
    terms: "Terms & Conditions",
    privacy: "Privacy Policy",
    cookies: "Cookie Policy",
    claimBook: "Complaints Book",
    contactTitle: "Contact & Bookings",
    address: "123 El Sol Ave, Cusco - Peru",
    phone: "+51 123 456 789",
    email: "reservas@travelik.com",
    hours: "Mon - Sat: 8:00 AM - 8:00 PM",
    rights: "All rights reserved.",
  },
  pt: {
    tagline: "Descubra as melhores experiências de viagem nos destinos mais incríveis do Peru.",
    quickLinks: "Navegação",
    destinations: "Destinos",
    about: "Sobre Nós",
    contact: "Contato",
    legal: "Informação Legal",
    terms: "Termos e Condições",
    privacy: "Política de Privacidade",
    cookies: "Política de Cookies",
    claimBook: "Livro de Reclamações",
    contactTitle: "Contato e Reservas",
    address: "Av. El Sol 123, Cusco - Perú",
    phone: "+51 123 456 789",
    email: "reservas@travelik.com",
    hours: "Seg - Sáb: 8:00 AM - 8:00 PM",
    rights: "Todos os direitos reservados.",
  },
};

const t = translations[currentLang] || translations.es;
---

<footer class="bg-background text-white border-t border-white/10 relative overflow-hidden">
  {/* SECCIÓN PRINCIPAL DEL FOOTER */}
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      
      {/* COLUMNA 1: LOGO Y DESCRIPCIÓN */}
      <div class="space-y-4">
        <a href={`/${currentLang}`} class="inline-block">
          <img
            src="/logo-white.webp"
            alt="TRAVELIK Logo"
            class="h-12 w-auto object-contain"
          />
        </a>
        <p class="text-white/70 text-sm leading-relaxed font-heading tracking-wide">
          {t.tagline}
        </p>
        
        {/* REDES SOCIALES */}
        <div class="flex items-center space-x-3 pt-2">
          <a href="#" aria-label="Facebook" class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/80 hover:text-primary hover:border-primary transition-all">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" aria-label="Instagram" class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/80 hover:text-primary hover:border-primary transition-all">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="#" aria-label="TikTok" class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/80 hover:text-primary hover:border-primary transition-all">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.98-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.67 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.54 2.77-1.5.42-.66.6-1.45.6-2.23V.02z"/></svg>
          </a>
        </div>
      </div>

      {/* COLUMNA 2: NAVEGACIÓN RÁPIDA */}
      <div>
        <h3 class="text-sm font-heading font-semibold text-white tracking-[2px] uppercase mb-4 border-b border-primary/40 pb-2 inline-block">
          {t.quickLinks}
        </h3>
        <ul class="space-y-2.5 font-heading text-xs sm:text-sm tracking-wider">
          <li>
            <a href={`/${currentLang}/programs`} class="text-white/70 hover:text-primary transition-colors block">
              {t.destinations}
            </a>
          </li>
          <li>
            <a href={`/${currentLang}/pricing`} class="text-white/70 hover:text-primary transition-colors block">
              {t.about}
            </a>
          </li>
          <li>
            <a href={`/${currentLang}/results`} class="text-white/70 hover:text-primary transition-colors block">
              {t.contact}
            </a>
          </li>
        </ul>
      </div>

      {/* COLUMNA 3: INFORMACIÓN LEGAL */}
      <div>
        <h3 class="text-sm font-heading font-semibold text-white tracking-[2px] uppercase mb-4 border-b border-primary/40 pb-2 inline-block">
          {t.legal}
        </h3>
        <ul class="space-y-2.5 font-heading text-xs sm:text-sm tracking-wider">
          <li>
            <a href="#" class="text-white/70 hover:text-primary transition-colors block">
              {t.terms}
            </a>
          </li>
          <li>
            <a href="#" class="text-white/70 hover:text-primary transition-colors block">
              {t.privacy}
            </a>
          </li>
          <li>
            <a href="#" class="text-white/70 hover:text-primary transition-colors block">
              {t.cookies}
            </a>
          </li>
          <li class="pt-2">
            <a href="#" class="inline-flex items-center gap-2 text-xs font-heading tracking-wider px-3 py-1.5 rounded bg-white/5 border border-white/10 hover:border-primary text-white/80 hover:text-white transition-all">
              <span>📖</span>
              <span>{t.claimBook}</span>
            </a>
          </li>
        </ul>
      </div>

      {/* COLUMNA 4: CONTACTO Y RESERVAS */}
      <div>
        <h3 class="text-sm font-heading font-semibold text-white tracking-[2px] uppercase mb-4 border-b border-primary/40 pb-2 inline-block">
          {t.contactTitle}
        </h3>
        <div class="space-y-3 font-heading text-xs sm:text-sm tracking-wider text-white/70">
          <div class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{t.address}</span>
          </div>

          <div class="flex items-center gap-2.5">
            <div class="text-primary scale-75 shrink-0 -ml-1">
              <Attend />
            </div>
            <a href="tel:+51123456789" class="hover:text-primary transition-colors">{t.phone}</a>
          </div>

          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:reservas@travelik.com" class="hover:text-primary transition-colors">{t.email}</a>
          </div>

          <div class="flex items-center gap-2.5 pt-1">
            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>{t.hours}</span>
          </div>
        </div>
      </div>

    </div>
  </div>

  {/* BARRA INFERIOR DE COPYRIGHT */}
  <div class="border-t border-white/10 bg-black/40 py-6">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-heading tracking-wider text-white/50">
      <p>© {new Date().getFullYear()} TRAVELIK. {t.rights}</p>
      <div class="flex items-center space-x-6">
        <span>Cusco - Perú</span>
      </div>
    </div>
  </div>
</footer>