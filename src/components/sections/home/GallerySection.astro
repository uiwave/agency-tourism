---
const galleryImages = [
  "/images/Tour-a-Machu-Picchu-03.webp",
  "/images/Canon-del-Colca-y-Aguas-Termales-de-La-Calera-03.webp",
  "/images/Tour-Huacachina-Buggy-Sandboarding-02.webp",
  "/images/puno.webp",
  "/images/City-Tour-Cusco-03.webp",
  "/images/Trekking-Montana-Arcoiris-Palcoyo-02.webp",
  "/images/Tour-a-Waqrapukara-04.webp",
  "/images/Montana-de-colores-06.webp",
];

const doubledImages = [...galleryImages, ...galleryImages];
---

<section class="relative w-full overflow-hidden">
  <img
    src="/images/bg/gelary-sp1.png"
    alt=""
    class="absolute top-0 left-0 w-full z-10 pointer-events-none"
    aria-hidden="true"
  />

  <div class="py-16 sm:py-24">
    <div class="w-full overflow-hidden">
      <div class="flex gap-4 w-max animate-[scroll-gallery_40s_linear_infinite] hover:[animation-play-state:paused]">
        {doubledImages.map((src) => (
          <div class="shrink-0 w-[280px] h-[260px] sm:w-[360px] sm:h-[360px] lg:w-[440px] lg:h-[450px] rounded-xl overflow-hidden">
            <img
              src={src}
              alt=""
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 ease-out hover:scale-105"
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <img
    src="/images/bg/gelary-sp2.png"
    alt=""
    class="absolute bottom-0 left-0 w-full z-10 pointer-events-none"
    aria-hidden="true"
  />
</section>
