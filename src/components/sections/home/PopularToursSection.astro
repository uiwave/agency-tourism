---
import { getTranslations } from "@/i18n";
import { getCollection } from "astro:content";
import TourCard from "@/components/TourCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";

const currentLang = Astro.currentLocale || "es";

const t = getTranslations(currentLang);

const allTours = await getCollection("tours");
const tours = allTours
  .filter((tour) => tour.id.startsWith(`${currentLang}/`))
  .map((tour) => ({
    id: tour.id.replace(/^[^/]+\//, ""),
    title: tour.data.title,
    duration: tour.data.duration,
    location: tour.data.destination,
    price: String(tour.data.price),
    image: tour.data.image,
    description: tour.data.description,
  }));
---

<section class="w-full overflow-hidden">
  <div class="uw-container uw-section">
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-12 gap-5"
    >
      <SectionHeading
        badge={t["popularTours.sectionBadge"]}
        title={t["popularTours.sectionTitle"]}
        subtitle={t["popularTours.sectionSubtitle"]}
        centered={false}
        class="space-y-2.5! max-w-2xl"
      />

      {
        /* CONTROLES DE NAVEGACIÓN (OCULTOS EN MÓVIL PEQUEÑO, VISIBLES DESDE SM) */
      }
      <div class="hidden items-center gap-3 self-end md:self-auto">
        <button
          id="prevBtn"
          aria-label="Anterior"
          class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-surface/80 hover:bg-card border border-border hover:border-primary text-white flex items-center justify-center transition-all duration-200 active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer shadow-md backdrop-blur-md"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <button
          id="nextBtn"
          aria-label="Siguiente"
          class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-primary text-primary-foreground hover:bg-primary/90 flex items-center justify-center transition-all duration-200 active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer shadow-lg shadow-primary/30"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>

    {/* CARRUSEL OPTIMIZADO PARA MÓVIL Y DESKTOP */}
    <div
      id="toursCarousel"
      class="flex gap-4 sm:gap-6 overflow-x-auto scrollbar-none scroll-smooth snap-x snap-mandatory py-2 -mx-4 px-4 sm:mx-0 sm:px-0"
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      {
        tours.map((tour) => (
          <TourCard
            id={tour.id}
            title={tour.title}
            duration={tour.duration}
            location={tour.location}
            price={tour.price}
            image={tour.image}
            description={tour.description}
            href={`/${currentLang}/tours/${tour.id}`}
            fromPrice={t["popularTours.fromPrice"]}
            btnText={t["popularTours.btnText"]}
          />
        ))
      }
    </div>

    {/* INDICADOR DE PUNTOS PARA NAVEGACIÓN EN MÓVIL (DOTS) */}
    <div id="carouselDots" class="flex items-center justify-center gap-2 mt-6">
      {
        tours.map((_: any, index: number) => (
          <span
            data-index={index}
            class="dot-indicator w-2.5 h-2.5 rounded-full bg-white/30 transition-all duration-300"
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  #toursCarousel::-webkit-scrollbar {
    display: none;
  }
  .dot-indicator.active {
    background-color: var(--color-primary, #eab308);
    width: 1.25rem;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const carousel = document.getElementById(
      "toursCarousel",
    ) as HTMLElement | null;
    const prevBtn = document.getElementById(
      "prevBtn",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "nextBtn",
    ) as HTMLButtonElement | null;
    const dots = document.querySelectorAll(".dot-indicator");

    if (!carousel) return;

    const getScrollAmount = () => {
      const firstCard = carousel.querySelector("article");
      if (!firstCard) return 300;
      const gap = window.innerWidth < 640 ? 16 : 24;
      return firstCard.clientWidth + gap;
    };

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        carousel.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        carousel.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
      });
    }

    const updateCarouselState = () => {
      // 1. Deshabilitar botones de flecha cuando corresponde
      if (prevBtn && nextBtn) {
        const maxScrollLeft = carousel.scrollWidth - carousel.clientWidth - 5;
        prevBtn.disabled = carousel.scrollLeft <= 5;
        nextBtn.disabled = carousel.scrollLeft >= maxScrollLeft;
      }

      // 2. Actualizar puntos (dots) de navegación en pantallas móviles
      if (dots.length > 0) {
        const cardWidth = getScrollAmount();
        const activeIndex = Math.round(carousel.scrollLeft / cardWidth);

        dots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.classList.add("active");
          } else {
            dot.classList.remove("active");
          }
        });
      }
    };

    carousel.addEventListener("scroll", updateCarouselState);
    window.addEventListener("resize", updateCarouselState);
    updateCarouselState();
  });
</script>
