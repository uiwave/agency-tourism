---

<section
  class="w-full py-12 sm:py-20 bg-background text-foreground overflow-hidden"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    {/* CABECERA */}
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-12 gap-5"
    >
      <div class="space-y-2.5 max-w-2xl">
        <div
          class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-surface border border-border text-primary font-heading text-xs sm:text-sm tracking-[2px]"
        >
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="text-white font-semibold">{t.sectionBadge}</span>
        </div>
        <h2
          class="font-heading text-2xl sm:text-5xl lg:text-6xl text-white tracking-wider uppercase leading-tight font-bold"
        >
          {t.sectionTitle}
        </h2>
        <p
          class="font-body text-white/90 text-sm sm:text-lg font-normal leading-relaxed"
        >
          {t.sectionSubtitle}
        </p>
      </div>

      {
        /* CONTROLES DE NAVEGACIÓN (OCULTOS EN MÓVIL PEQUEÑO, VISIBLES DESDE SM) */
      }
      <div class="hidden sm:flex items-center gap-3 self-end md:self-auto">
        <button
          id="prevBtn"
          aria-label="Anterior"
          class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-surface/80 hover:bg-card border border-border hover:border-primary text-white flex items-center justify-center transition-all duration-200 active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer shadow-md backdrop-blur-md"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <button
          id="nextBtn"
          aria-label="Siguiente"
          class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-primary text-primary-foreground hover:bg-primary/90 flex items-center justify-center transition-all duration-200 active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer shadow-lg shadow-primary/30"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>

    {/* CARRUSEL OPTIMIZADO PARA MÓVIL Y DESKTOP */}
    <div
      id="toursCarousel"
      class="flex gap-4 sm:gap-6 overflow-x-auto scrollbar-none scroll-smooth snap-x snap-mandatory py-2 -mx-4 px-4 sm:mx-0 sm:px-0"
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      {
        t.tours.map((tour: any) => (
          <article class="flex-none w-[82%] sm:w-[calc(50%-12px)] md:w-[calc(33.333%-16px)] lg:w-[calc(25%-18px)] snap-center sm:snap-start group cursor-pointer">
            {/* CARD TIPO EDITORIAL CON ALTO MÓVIL ADAPTATIVO */}
            <div class="relative w-full h-[400px] sm:h-[460px] rounded-2xl overflow-hidden border border-border/80 hover:border-primary/80 transition-all duration-500 hover:shadow-2xl hover:shadow-primary/20 flex flex-col justify-between p-4 sm:p-6 bg-card">
              {/* 1. IMAGEN DE FONDO */}
              <div class="absolute inset-0 z-0">
                <img
                  src={tour.image}
                  alt={tour.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-black/30 group-hover:via-black/60 transition-colors" />
              </div>

              {/* 2. ETIQUETAS SUPERIORES */}
              <div class="relative z-10 flex items-center justify-between gap-1.5">
                <span class="px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-black/75 backdrop-blur-md border border-white/20 text-white font-body text-xs sm:text-sm font-semibold flex items-center gap-1.5 shadow-md">
                  <svg
                    class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-primary"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                  {tour.location}
                </span>

                <span class="px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-black/75 backdrop-blur-md border border-white/20 text-white font-body text-xs sm:text-sm font-semibold flex items-center gap-1.5 shadow-md">
                  <svg
                    class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-primary"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                  {tour.duration}
                </span>
              </div>

              {/* 3. CONTENIDO INFERIOR */}
              <div class="relative z-10 space-y-2.5 sm:space-y-3.5 pt-4">
                <h3 class="font-heading text-lg sm:text-2xl text-white font-semibold tracking-wide leading-tight group-hover:text-primary transition-colors line-clamp-2 drop-shadow-md">
                  {tour.title}
                </h3>

                <p class="font-body text-xs sm:text-sm text-white/95 line-clamp-2 leading-relaxed font-normal drop-shadow-sm">
                  {tour.description}
                </p>

                {/* PRECIO Y BOTÓN */}
                <div class="pt-3 border-t border-white/25 flex items-center justify-between">
                  <div>
                    <span class="block text-[10px] sm:text-xs font-body text-white/80 uppercase tracking-wider font-medium">
                      {t.fromPrice}
                    </span>
                    <div class="flex items-baseline gap-1">
                      <span class="font-heading text-xl sm:text-3xl text-primary font-bold tracking-tight">
                        ${tour.price}
                      </span>
                      <span class="text-[10px] sm:text-xs text-white/90 font-medium">
                        USD
                      </span>
                    </div>
                  </div>

                  <a
                    href={`/${currentLang}/tours/${tour.id}`}
                    class="bg-primary hover:bg-primary/90 text-primary-foreground font-heading text-xs sm:text-sm font-bold tracking-wider px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl transition-all duration-300 transform group-hover:-translate-y-0.5 shadow-md shadow-primary/30 flex items-center gap-1.5"
                  >
                    <span>{t.btnText}</span>
                    <svg
                      class="w-3.5 h-3.5 sm:w-4 sm:h-4 transition-transform duration-200 group-hover:translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"
                      />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    {/* INDICADOR DE PUNTOS PARA NAVEGACIÓN EN MÓVIL (DOTS) */}
    <div
      id="carouselDots"
      class="flex sm:hidden items-center justify-center gap-2 mt-6"
    >
      {
        t.tours.map((_: any, index: number) => (
          <span
            data-index={index}
            class="dot-indicator w-2.5 h-2.5 rounded-full bg-white/30 transition-all duration-300"
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  #toursCarousel::-webkit-scrollbar {
    display: none;
  }
  .dot-indicator.active {
    background-color: var(--color-primary, #eab308);
    width: 1.25rem;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const carousel = document.getElementById(
      "toursCarousel",
    ) as HTMLElement | null;
    const prevBtn = document.getElementById(
      "prevBtn",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "nextBtn",
    ) as HTMLButtonElement | null;
    const dots = document.querySelectorAll(".dot-indicator");

    if (!carousel) return;

    const getScrollAmount = () => {
      const firstCard = carousel.querySelector("article");
      if (!firstCard) return 300;
      const gap = window.innerWidth < 640 ? 16 : 24;
      return firstCard.clientWidth + gap;
    };

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        carousel.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        carousel.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
      });
    }

    const updateCarouselState = () => {
      // 1. Deshabilitar botones de flecha cuando corresponde
      if (prevBtn && nextBtn) {
        const maxScrollLeft = carousel.scrollWidth - carousel.clientWidth - 5;
        prevBtn.disabled = carousel.scrollLeft <= 5;
        nextBtn.disabled = carousel.scrollLeft >= maxScrollLeft;
      }

      // 2. Actualizar puntos (dots) de navegación en pantallas móviles
      if (dots.length > 0) {
        const cardWidth = getScrollAmount();
        const activeIndex = Math.round(carousel.scrollLeft / cardWidth);

        dots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.classList.add("active");
          } else {
            dot.classList.remove("active");
          }
        });
      }
    };

    carousel.addEventListener("scroll", updateCarouselState);
    window.addEventListener("resize", updateCarouselState);
    updateCarouselState();
  });
</script>
