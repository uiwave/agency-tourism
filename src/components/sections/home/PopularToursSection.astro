---
import { getTranslations } from "@/i18n";
import { getCollection } from "astro:content";
import TourCard from "@/components/TourCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";

const currentLang = Astro.currentLocale || "es";

const t = getTranslations(currentLang);

const allTours = await getCollection("tours");
const tours = allTours
  .filter((tour) => tour.id.startsWith(`${currentLang}/`))
  .map((tour) => ({
    id: tour.id.replace(/^[^/]+\//, ""),
    title: tour.data.title,
    duration: tour.data.duration,
    location: tour.data.destination,
    price: String(tour.data.price),
    image: tour.data.image,
    description: tour.data.description,
  }));
---

<section class="w-full overflow-hidden">
  <div class="uw-container uw-section pb-0">
    <div class="mb-8 sm:mb-12">
      <SectionHeading
        title={t["popularTours.sectionTitle"]}
        subtitle={t["popularTours.sectionSubtitle"]}
        centered={false}
      />
    </div>

    <div
      id="toursCarousel"
      class="grid grid-flow-col auto-cols-[100%] sm:auto-cols-[calc(50%-12px)] md:auto-cols-[calc(33.333%-16px)] lg:auto-cols-[calc(25%-18px)] gap-4 sm:gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory py-2 -mx-4 px-4 sm:mx-0 sm:px-0"
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      {
        tours.map((tour) => (
          <TourCard
            id={tour.id}
            title={tour.title}
            duration={tour.duration}
            location={tour.location}
            price={tour.price}
            image={tour.image}
            description={tour.description}
            href={`/${currentLang}/tours/${tour.id}`}
            fromPrice={t["popularTours.fromPrice"]}
            btnText={t["popularTours.btnText"]}
          />
        ))
      }
    </div>

    {/* INDICADOR DE PUNTOS */}
    <div id="carouselDots" class="flex items-center justify-center gap-2 mt-6">
      {
        tours.map((_: any, index: number) => (
          <span
            data-index={index}
            class="dot-indicator w-2.5 h-2.5 rounded-full bg-white/30 transition-all duration-300"
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  #toursCarousel::-webkit-scrollbar {
    display: none;
  }
  .dot-indicator.active {
    background-color: var(--color-primary, #eab308);
    width: 1.25rem;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const carousel = document.getElementById(
      "toursCarousel",
    ) as HTMLElement | null;
    const dots = document.querySelectorAll(".dot-indicator");
    if (!carousel || dots.length === 0) return;

    const getVisibleCount = () => {
      const w = window.innerWidth;
      if (w >= 1024) return 4;
      if (w >= 768) return 3;
      if (w >= 640) return 2;
      return 1;
    };

    const updateDots = () => {
      const visibleCount = getVisibleCount();
      const totalItems = carousel.querySelectorAll("article").length;
      const maxIndex = Math.max(totalItems - visibleCount, 0);
      const cardWidth = carousel.scrollWidth / totalItems;
      const activeIndex = Math.min(
        Math.round(carousel.scrollLeft / cardWidth),
        maxIndex,
      );

      dots.forEach((dot, idx) => {
        dot.classList.toggle("active", idx === activeIndex);
      });
    };

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const index = parseInt(dot.getAttribute("data-index") || "0");
        const cards = carousel.querySelectorAll("article");
        if (cards[index]) {
          cards[index].scrollIntoView({
            behavior: "smooth",
            inline: "start",
            block: "nearest",
          });
        }
      });
    });

    carousel.addEventListener("scroll", updateDots);
    window.addEventListener("resize", updateDots);
    updateDots();
  });
</script>
