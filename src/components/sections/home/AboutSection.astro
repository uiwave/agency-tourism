---
const currentLang = Astro.currentLocale || "es";

const aboutData = {
  badge: "SOBRE NOSOTROS",
  title: "Apasionados por mostrarte lo mejor de Brasil.",
  description: "Nos especializamos en crear viajes a medida que conectan a nuestros clientes con la cultura vibrante, paisajes inolvidables y la calidez de la gente local.",
  stats: [
    { value: "+10k", label: "Viajeros felices" },
    { value: "15+", label: "Años de experiencia" },
    { value: "4.9/5", label: "Calificación promedio" },
  ],
  features: [
    {
      title: "Anfitriones locales",
      description: "Guías expertos nativos que conocen cada rincón escondido y la historia real del destino.",
      icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
    },
    {
      title: "Experiencias exclusivas",
      description: "Itinerarios personalizados lejos del turismo masivo para vivir emociones auténticas.",
      icon: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
    }
  ]
};
---

<section class="relative w-full py-20 lg:py-28 px-4 sm:px-6 lg:px-8 bg-zinc-950 text-white select-none">
  <div class="max-w-7xl mx-auto space-y-16">
    
    <!-- PARTE SUPERIOR: TÍTULO Y DESCRIPCIÓN -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      
      <!-- Columna Izquierda: Badge y Título -->
      <div class="lg:col-span-7 space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-bold tracking-widest uppercase text-white/90">
          <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
          {aboutData.badge}
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.15] drop-shadow-md">
          {aboutData.title}
        </h2>
      </div>

      <!-- Columna Derecha: Descripción -->
      <div class="lg:col-span-5">
        <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed drop-shadow-sm">
          {aboutData.description}
        </p>
      </div>

    </div>

    <!-- PARTE INFERIOR: TARJETAS Y ESTADÍSTICAS -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Columna Izquierda: Tarjetas de Características -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          aboutData.features.map((feature) => (
            <div class="p-8 rounded-3xl bg-black/40 backdrop-blur-md border border-white/15 shadow-xl flex flex-col justify-between space-y-6 group hover:border-white/30 transition duration-300">
              <div class="w-12 h-12 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-white group-hover:bg-white group-hover:text-black transition duration-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.icon}></path>
                </svg>
              </div>
              <div class="space-y-2">
                <h3 class="text-xl font-bold text-white">{feature.title}</h3>
                <p class="text-sm text-gray-300 font-normal leading-relaxed">{feature.description}</p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Columna Derecha: Tarjeta de Métricas / Estadísticas -->
      <div class="lg:col-span-5 p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-white/10 via-black/50 to-black/80 backdrop-blur-xl border border-white/20 shadow-2xl flex flex-col justify-between">
        <div class="space-y-2">
          <span class="text-xs font-bold tracking-widest text-white/60 uppercase">NUESTRO IMPACTO</span>
          <h3 class="text-2xl font-bold text-white">Transformando la forma de viajar</h3>
        </div>

        <div class="grid grid-cols-3 gap-4 pt-8 border-t border-white/15 mt-8">
          {
            aboutData.stats.map((stat) => (
              <div class="space-y-1">
                <p class="text-2xl sm:text-3xl font-black text-white tracking-tight">{stat.value}</p>
                <p class="text-xs text-gray-400 font-medium">{stat.label}</p>
              </div>
            ))
          }
        </div>
      </div>

    </div>

  </div>
</section>