---
import { getTranslations } from "@/i18n";

const currentLang = Astro.currentLocale || "es";

const t = getTranslations(currentLang);

const services = [
  { icon: "guia", text: t["about.feature1Title"] },
  { icon: "tour", text: t["about.feature2Title"] },
  { icon: "seguro", text: t["about.feature3Title"] },
  { icon: "vuelos", text: "Vuelos Incluidos" },
  { icon: "hoteles", text: "Hoteles Seleccionados" },
  { icon: "traslados", text: "Traslados Privados" },
  { icon: "asistencia", text: "Asistencia 24/7" },
  { icon: "experiencia", text: "+10 Años de Experiencia" },
];
---

<section class="relative min-h-screen text-white overflow-hidden py-16 sm:py-24 px-6 sm:px-12 lg:px-20 flex items-center"
  style="background-image: url('/images/bg/about-bg.png'); background-size: cover; background-position: center;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

    <!-- COLUMNA IZQUIERDA: Contenido -->
    <div class="lg:col-span-6 space-y-8 z-10">

      <!-- Badge + Título -->
      <div class="space-y-3">
        <p class="text-primary tracking-[4px] font-heading text-sm sm:text-base uppercase font-bold">
          {t["about.badge"]}
        </p>
        <h2 class="font-heading text-5xl sm:text-7xl lg:text-8xl uppercase leading-none tracking-tight text-white">
          {t["about.title"]}
        </h2>
      </div>

      <!-- Grid de Servicios (2 columnas) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-3 gap-x-6 pt-4 text-sm sm:text-base text-white/80">
        <ul class="space-y-3">
          {services.slice(0, 4).map((service) => (
            <li class="flex items-center space-x-2">
              <span class="bg-primary text-white rounded-full p-0.5 text-[10px] flex items-center justify-center w-4 h-4 font-bold">✓</span>
              <span class="font-body">{service.text}</span>
            </li>
          ))}
        </ul>
        <ul class="space-y-3">
          {services.slice(4).map((service) => (
            <li class="flex items-center space-x-2">
              <span class="bg-primary text-white rounded-full p-0.5 text-[10px] flex items-center justify-center w-4 h-4 font-bold">✓</span>
              <span class="font-body">{service.text}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Botón + Teléfono -->
      <div class="flex flex-wrap items-center gap-6 pt-6">
        <a
          href={currentLang === "es" ? "/tours" : `/${currentLang}/tours`}
          class="bg-primary text-white font-heading font-bold px-8 py-3.5 rounded-full hover:bg-primary/90 transition-colors duration-300 text-center shadow-lg shadow-primary/30 tracking-wider text-sm"
        >
          {t["hero.btnPrimary"]}
        </a>

        <div class="flex items-center space-x-3">
          <div class="p-2 border border-primary rounded-full text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <p class="font-heading text-lg sm:text-xl leading-tight text-white">{t["footer.phone"]}</p>
            <p class="text-xs text-white/50 uppercase tracking-[3px] font-heading">{t["contact.infoHours"]}</p>
          </div>
        </div>
      </div>

    </div>

    <!-- COLUMNA DERECHA: Galería Polaroid -->
    <div class="lg:col-span-6 relative flex justify-center items-center mt-8 lg:mt-0">

      <!-- Fondo decorativo -->
      <div class="absolute -right-4 top-0 w-3/4 h-full bg-card/50 rounded-2xl -z-10 hidden sm:block"></div>

      <!-- Badge de Descuento -->
      <div class="absolute -top-6 left-2 sm:left-10 z-30 bg-primary text-white w-28 h-28 sm:w-36 sm:h-36 rounded-full flex flex-col justify-center items-center text-center p-2 shadow-2xl rotate-[-12deg] border-4 border-dashed border-primary/60">
        <span class="text-xs sm:text-sm font-heading font-semibold tracking-wider">Desde</span>
        <span class="text-2xl sm:text-4xl font-heading font-extrabold leading-none">{t["about.stat1Value"]}</span>
        <span class="text-[10px] sm:text-xs font-heading font-bold tracking-[2px] uppercase mt-1">{t["about.stat1Label"]}</span>
      </div>

      <!-- Contenedor Polaroid -->
      <div class="relative w-full max-w-md sm:max-w-lg h-[480px] sm:h-[580px] flex items-center justify-center">

        <!-- Foto 1 -->
        <div class="absolute top-0 right-2 w-64 sm:w-80 p-3 bg-white shadow-2xl rotate-[6deg] hover:rotate-0 transition-transform duration-300 z-10">
          <div class="overflow-hidden h-40 sm:h-48">
            <img
              src="/images/Tour-a-Machu-Picchu-03.webp"
              alt="Machu Picchu"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Foto 2 -->
        <div class="absolute top-36 left-0 sm:left-4 w-72 sm:w-96 p-3 bg-white shadow-2xl rotate-[-4deg] hover:rotate-0 transition-transform duration-300 z-20">
          <div class="overflow-hidden h-44 sm:h-56">
            <img
              src="/images/Canon-del-Colca-y-Aguas-Termales-de-La-Calera-03.webp"
              alt="Cañón del Colca"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Foto 3 -->
        <div class="absolute bottom-0 right-4 sm:right-8 w-64 sm:w-80 p-3 bg-white shadow-2xl rotate-[-2deg] hover:rotate-0 transition-transform duration-300 z-20">
          <div class="overflow-hidden h-40 sm:h-48">
            <img
              src="/images/Tour-Huacachina-Buggy-Sandboarding-02.webp"
              alt="Huacachina"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
