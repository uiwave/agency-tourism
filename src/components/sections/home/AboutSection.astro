---
import { getTranslations } from "@/i18n";
import SectionHeading from "@/components/SectionHeading.astro";

const currentLang = Astro.currentLocale || "es";

const t = getTranslations(currentLang);

const services = [
  { icon: "guia", text: t["about.feature1Title"] },
  { icon: "tour", text: t["about.feature2Title"] },
  { icon: "seguro", text: t["about.feature3Title"] },
  { icon: "vuelos", text: "Vuelos Incluidos" },
  { icon: "hoteles", text: "Hoteles Seleccionados" },
  { icon: "traslados", text: "Traslados Privados" },
  { icon: "asistencia", text: "Asistencia 24/7" },
  { icon: "experiencia", text: "+10 Años de Experiencia" },
];
---

<section
  class="relative text-white overflow-hidden flex items-center"
  style="background-image: url('/images/bg/about-bg.png'); background-size: cover; background-position: center;"
>
  <div
    class="uw-container uw-section grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center"
  >
    <!-- COLUMNA IZQUIERDA: Contenido -->
    <div class="lg:col-span-6 space-y-8 z-10">
      <!-- Título -->
      <SectionHeading title={t["about.title"]} centered={false} />

      <!-- Grid de Servicios (2 columnas) -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 gap-y-3 gap-x-6 pt-4 text-sm sm:text-base text-white/80"
      >
        <ul class="space-y-3">
          {
            services.slice(0, 4).map((service) => (
              <li class="flex items-center space-x-2">
                <span class="bg-primary text-white rounded-full p-0.5 text-[10px] flex items-center justify-center w-4 h-4 font-bold">
                  ✓
                </span>
                <span class="font-body">{service.text}</span>
              </li>
            ))
          }
        </ul>
        <ul class="space-y-3">
          {
            services.slice(4).map((service) => (
              <li class="flex items-center space-x-2">
                <span class="bg-primary text-white rounded-full p-0.5 text-[10px] flex items-center justify-center w-4 h-4 font-bold">
                  ✓
                </span>
                <span class="font-body">{service.text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Botón + Teléfono -->
      <div class="flex flex-wrap items-center gap-6 pt-6">
        <a
          href={currentLang === "es" ? "/tours" : `/${currentLang}/tours`}
          class="bg-primary text-white font-heading font-bold px-8 py-3.5 rounded-full hover:bg-primary/90 transition-colors duration-300 text-center shadow-lg shadow-primary/30 tracking-wider text-sm"
        >
          {t["hero.btnPrimary"]}
        </a>

        <div class="flex items-center space-x-3">
          <div class="p-2 border border-primary rounded-full text-primary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
          </div>
          <div>
            <p class="font-heading text-lg sm:text-xl leading-tight text-white">
              {t["footer.phone"]}
            </p>
            <p
              class="text-xs text-white/50 uppercase tracking-[3px] font-heading"
            >
              {t["contact.infoHours"]}
            </p>
          </div>
        </div>
      </div>
    </div>

    <div
      class="lg:col-span-6 relative flex justify-center items-center mt-8 lg:mt-0"
    >
      <div
        class="relative w-full max-w-md sm:max-w-lg h-120 sm:h-145 flex items-center justify-center"
      >
        <div
          class="absolute top-0 right-2 w-64 sm:w-80 p-3 bg-white shadow-2xl rotate-6 hover:rotate-0 transition-transform duration-300 z-10"
        >
          <div class="overflow-hidden h-40 sm:h-48">
            <img
              src="/images/Tour-a-Machu-Picchu-03.webp"
              alt="Machu Picchu"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <div
          class="absolute top-36 left-0 sm:left-4 w-72 sm:w-96 p-3 bg-white shadow-2xl rotate-[-4deg] hover:rotate-0 transition-transform duration-300 z-20"
        >
          <div class="overflow-hidden h-44 sm:h-56">
            <img
              src="/images/Canon-del-Colca-y-Aguas-Termales-de-La-Calera-03.webp"
              alt="Cañón del Colca"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <div
          class="absolute bottom-0 right-4 sm:right-8 w-64 sm:w-80 p-3 bg-white shadow-2xl -rotate-2 hover:rotate-0 transition-transform duration-300 z-20"
        >
          <div class="overflow-hidden h-40 sm:h-48">
            <img
              src="/images/Tour-Huacachina-Buggy-Sandboarding-02.webp"
              alt="Huacachina"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
