---
const testimonialsData = {
  badge: "TESTIMONIOS",
  title: "Lo que dicen nuestros viajeros",
  description: "Descubre las historias de personas reales que confiaron en nosotros para explorar lo mejor de Brasil.",
  reviews: [
    {
      name: "Camila Rodríguez",
      role: "Viajera desde Argentina",
      avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=250&auto=format&fit=crop",
      rating: 5,
      comment: "Una experiencia inigualable en Río de Janeiro. El equipo se encargó de cada detalle, los guías locales fueron súper atentos y la atención 24/7 nos dio muchísima tranquilidad.",
    },
    {
      name: "Mateo Silva",
      role: "Viajero desde Chile",
      avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=250&auto=format&fit=crop",
      rating: 5,
      comment: "El itinerario por las playas de Búzios y Paraty estuvo organizado a la perfección. Definitivamente superó nuestras expectativas. ¡Repetiría sin dudarlo!",
    },
    {
      name: "Lucía Fernández",
      role: "Viajera desde Uruguay",
      avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=250&auto=format&fit=crop",
      rating: 5,
      comment: "Buscábamos una combinación de aventura y relajación, y superaron todo lo planeado. Excelente relación calidad-precio y recomendaciones locales increíbles.",
    },
  ],
};
---

<section class="relative w-full py-20 lg:py-28 px-4 sm:px-6 lg:px-8 bg-zinc-950 text-white select-none">
  <div class="max-w-7xl mx-auto space-y-16">
    
    <!-- ENCABEZADO -->
    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-bold tracking-widest uppercase text-white/90">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        {testimonialsData.badge}
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.15] drop-shadow-md">
        {testimonialsData.title}
      </h2>

      <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed drop-shadow-sm max-w-2xl">
        {testimonialsData.description}
      </p>
    </div>

    <!-- TARJETAS DE TESTIMONIOS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {
        testimonialsData.reviews.map((review) => (
          <div class="p-8 rounded-3xl bg-black/40 backdrop-blur-md border border-white/15 shadow-xl flex flex-col justify-between space-y-6 group hover:border-white/30 transition duration-300">
            
            <!-- Estrellas y Comentario -->
            <div class="space-y-4">
              <!-- Calificación con Estrellas -->
              <div class="flex items-center gap-1 text-amber-400">
                {Array.from({ length: review.rating }).map(() => (
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>

              <!-- Comentario -->
              <p class="text-base text-gray-200 font-normal leading-relaxed italic drop-shadow-sm">
                "{review.comment}"
              </p>
            </div>

            <!-- Perfil del usuario -->
            <div class="flex items-center gap-4 pt-4 border-t border-white/10">
              <img 
                src={review.avatar} 
                alt={review.name} 
                class="w-12 h-12 rounded-full object-cover border border-white/20 shrink-0"
              />
              <div class="space-y-0.5">
                <h3 class="text-base font-bold text-white leading-tight">{review.name}</h3>
                <p class="text-xs text-gray-400 font-medium">{review.role}</p>
              </div>
            </div>

          </div>
        ))
      }
    </div>

  </div>
</section>