---
import { getTranslations } from "@/i18n";

const currentLang = Astro.currentLocale || "es";

const t = getTranslations(currentLang);

const testimonials = [
  {
    name: t["testimonials.item1Name"],
    country: t["testimonials.item1Country"],
    text: t["testimonials.item1Text"],
    initials: "MG",
  },
  {
    name: t["testimonials.item2Name"],
    country: t["testimonials.item2Country"],
    text: t["testimonials.item2Text"],
    initials: "JW",
  },
  {
    name: t["testimonials.item3Name"],
    country: t["testimonials.item3Country"],
    text: t["testimonials.item3Text"],
    initials: "AS",
  },
];
---

<section class="w-full py-16 sm:py-24 bg-surface/30 text-foreground">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

    <!-- ENCABEZADO -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface border border-border text-primary font-heading text-xs sm:text-sm tracking-[2px]">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="text-white font-semibold">{t["testimonials.badge"]}</span>
      </div>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl text-white tracking-wider uppercase leading-tight font-bold">
        {t["testimonials.title"]}
      </h2>
    </div>

    <!-- GRID DE TESTIMONIOS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        testimonials.map((testimonial) => (
          <div class="p-6 sm:p-8 rounded-2xl bg-card border border-border/50 hover:border-primary/30 transition-all duration-300 space-y-5">
            {/* Estrellas */}
            <div class="flex gap-1">
              {[1, 2, 3, 4, 5].map(() => (
                <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            {/* Texto */}
            <p class="font-body text-white/70 text-sm sm:text-base leading-relaxed italic">
              "{testimonial.text}"
            </p>

            {/* Autor */}
            <div class="flex items-center gap-3 pt-2 border-t border-border/50">
              <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center">
                <span class="font-heading text-sm text-primary font-bold">{testimonial.initials}</span>
              </div>
              <div>
                <p class="font-heading text-sm text-white font-semibold">{testimonial.name}</p>
                <p class="font-body text-xs text-white/50">{testimonial.country}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>
