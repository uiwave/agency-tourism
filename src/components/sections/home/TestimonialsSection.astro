---
import { getTranslations } from "@/i18n";
import { testimonials } from "@/data/testimonials";
import SectionHeading from "@/components/SectionHeading.astro";

const currentLang = Astro.currentLocale || "es";

const t = getTranslations(currentLang);
---

<section class="w-full py-16 sm:py-24 bg-surface/30 text-foreground overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

    <!-- ENCABEZADO -->
    <SectionHeading
      badge={t["testimonials.badge"]}
      title={t["testimonials.title"]}
    />

    <!-- CARRUSEL INFINITO -->
    <div class="relative">
      {/* Fade lateral izquierdo */}
      <div class="absolute left-0 top-0 bottom-0 w-16 sm:w-32 bg-gradient-to-r from-surface/30 to-transparent z-10 pointer-events-none"></div>
      {/* Fade lateral derecho */}
      <div class="absolute right-0 top-0 bottom-0 w-16 sm:w-32 bg-gradient-to-l from-surface/30 to-transparent z-10 pointer-events-none"></div>

      <div class="testimonials-track flex gap-6 w-max">
        {[...testimonials, ...testimonials].map((testimonial) => (
          <article class="flex-none w-[320px] sm:w-[380px] p-6 rounded-2xl bg-card border border-border/30 hover:border-border/60 transition-all duration-300 flex flex-col justify-between min-h-[280px]">
            {/* Rating + Fecha */}
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-1.5">
                {[1, 2, 3, 4, 5].map((star) => (
                  <svg
                    class={`w-3.5 h-3.5 ${star <= testimonial.rating ? "text-green-500" : "text-white/15"}`}
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                ))}
                <span class="ml-1 font-body text-xs text-white/40">{testimonial.rating}.0</span>
              </div>
              <span class="font-body text-xs text-white/30">{testimonial.date}</span>
            </div>

            {/* Texto */}
            <p class="font-body text-white/70 text-sm sm:text-[15px] leading-relaxed flex-1">
              {testimonial.text}
            </p>

            {/* Autor */}
            <div class="mt-5 pt-4 border-t border-border/30 flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-primary/15 flex items-center justify-center shrink-0">
                <span class="font-heading text-xs text-primary font-bold">{testimonial.initials}</span>
              </div>
              <div>
                <p class="font-heading text-sm text-white font-medium">{testimonial.name}</p>
                <p class="font-body text-xs text-white/40">{testimonial.country} · {testimonial.tripType}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .testimonials-track {
    animation: scroll-testimonials 60s linear infinite;
  }

  .testimonials-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll-testimonials {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
