---
import { getTranslations } from "@/i18n";
import { testimonials } from "@/data/testimonials";

const currentLang = Astro.currentLocale || "es";

const t = getTranslations(currentLang);
---

<section class="w-full py-16 sm:py-24 bg-surface/30 text-foreground overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

    <!-- ENCABEZADO -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface border border-border text-primary font-heading text-xs sm:text-sm tracking-[2px]">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="text-white font-semibold">{t["testimonials.badge"]}</span>
      </div>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl text-white tracking-wider uppercase leading-tight font-bold">
        {t["testimonials.title"]}
      </h2>
    </div>

    <!-- CARRUSEL INFINITO -->
    <div class="relative">
      {/* Fade lateral izquierdo */}
      <div class="absolute left-0 top-0 bottom-0 w-16 sm:w-32 bg-gradient-to-r from-surface/30 to-transparent z-10 pointer-events-none"></div>
      {/* Fade lateral derecho */}
      <div class="absolute right-0 top-0 bottom-0 w-16 sm:w-32 bg-gradient-to-l from-surface/30 to-transparent z-10 pointer-events-none"></div>

      <div class="testimonials-track flex gap-6 w-max">
        {[...testimonials, ...testimonials].map((testimonial) => (
          <article class="flex-none w-[320px] sm:w-[380px] p-6 sm:p-8 rounded-2xl bg-card border border-border/50 hover:border-primary/30 transition-all duration-300 space-y-5">
            {/* Header: Avatar + Name + Date */}
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center shrink-0">
                  <span class="font-heading text-sm text-primary font-bold">{testimonial.initials}</span>
                </div>
                <div>
                  <p class="font-heading text-sm text-white font-semibold">{testimonial.name}</p>
                  <p class="font-body text-xs text-white/50">{testimonial.country}</p>
                </div>
              </div>
              <span class="font-body text-xs text-white/40 bg-surface/80 px-2 py-1 rounded-full shrink-0">{testimonial.date}</span>
            </div>

            {/* Estrellas TripAdvisor */}
            <div class="flex gap-0.5">
              {[1, 2, 3, 4, 5].map((star) => (
                <svg
                  class={`w-4 h-4 ${star <= testimonial.rating ? "text-green-500" : "text-white/20"}`}
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
              ))}
              <span class="ml-2 font-body text-xs text-white/50 self-center">{testimonial.rating}.0</span>
            </div>

            {/* Texto del review */}
            <p class="font-body text-white/70 text-sm sm:text-base leading-relaxed italic line-clamp-5">
              "{testimonial.text}"
            </p>

            {/* Footer: Trip type */}
            <div class="pt-3 border-t border-border/50 flex items-center gap-2">
              <svg class="w-4 h-4 text-primary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
              <span class="font-body text-xs text-white/50">{testimonial.tripType}</span>
            </div>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .testimonials-track {
    animation: scroll-testimonials 60s linear infinite;
  }

  .testimonials-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll-testimonials {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
