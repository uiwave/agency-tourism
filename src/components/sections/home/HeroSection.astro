---
import { getTranslations } from "@/i18n";

const currentLang = Astro.currentLocale || "es";

const t = getTranslations(currentLang);
---

<section
  class="relative w-full min-h-[95vh] flex items-center justify-center overflow-hidden"
>
  <div class="absolute inset-0 z-0">
    <video
      autoplay
      loop
      muted
      playsinline
      class="w-full h-full object-cover scale-105"
    >
      <source src="/videos/chull-banner.mp4" type="video/mp4" />
      Tu navegador no soporta el formato de video.
    </video>
    <div class="absolute inset-0 bg-black/50"></div>
  </div>

  <img
    src="/images/bg/hero-bg.webp"
    alt=""
    class="absolute bottom-0 left-0 w-full z-10 pointer-events-none"
  />

  {/* 2. CONTENIDO PRINCIPAL */}
  <div
    class="relative z-20 container mx-auto px-4 sm:px-6 lg:px-8 pt-16 text-center"
  >
    {/* Aumentado a max-w-6xl para dar amplitud horizontal */}
    <div class="space-y-5 sm:space-y-6">
      {/* BADGE ELEGANTE */}
      <span class="font-decoration text-primary text-[clamp(1rem,0.643rem+0.893vw,1.5rem)] tracking-[4px]">{t["hero.badge"]}</span>
      

      {/* TÍTULO IMPACTANTE CON ALTURA DE LÍNEA AJUSTADA */}
      <h1
        id="hero-title"
        data-text={t["hero.title"]}
        class="font-heading text-[clamp(4.688rem,-9.821rem+36.272vw,25rem)] leading-none text-white"
      >
      </h1>
    </div>
  </div>
</section>

<script>
  import { $ } from "@/lib/dom";

  const title = $<HTMLElement>("#hero-title")!;

  const text = title.dataset.text ?? "";
  let index = 0;

  function typeWriter() {
    if (index < text.length) {
      title.textContent += text.charAt(index);
      index++;

      setTimeout(typeWriter, 120);
    }
  }

  typeWriter();
</script>
