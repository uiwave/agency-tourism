---
import { getTranslations } from "@/i18n";

const currentLang = Astro.currentLocale || "es";
const t = getTranslations(currentLang);
---

<section
  class="relative h-screen flex items-center justify-center bg-cover bg-center bg-no-repeat"
  style={`background-image: url('/images/Tour-en-Bote-a-Islas-Ballestas-y-Candelabro-02.webp')`}
>
  <div class="absolute inset-0 bg-black/50"></div>

  <div class="relative z-10 text-center px-4 max-w-3xl mx-auto">
    <h1 class="font-heading text-6xl md:text-8xl text-white mb-4 tracking-wide">
      {t["hero.title"]}
    </h1>
    <p class="font-body text-lg md:text-xl text-gray-200 mb-8">
      {t["hero.subtitle"]}
    </p>
    <a
      href={`/${currentLang}/tours`}
      class="inline-block bg-primary text-primary-foreground font-body font-semibold px-8 py-3 rounded-lg hover:opacity-90 transition-opacity"
    >
      {t["hero.cta"]}
    </a>
  </div>
</section>
