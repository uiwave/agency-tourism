---
import { getTranslations } from "@/i18n";

const currentLang = Astro.currentLocale || "es";

const t = getTranslations(currentLang);
---

<section
  class="relative w-full h-screen min-h-[600px] flex items-center justify-center overflow-hidden bg-background"
>
  {/* 1. VIDEO DE FONDO A PANTALLA COMPLETA CON MAYOR OSCURIDAD */}
  <div class="absolute inset-0 z-0">
    <video
      autoplay
      loop
      muted
      playsinline
      class="w-full h-full object-cover scale-105"
    >
      <source src="/videos/chull-banner.mp4" type="video/mp4" />
      Tu navegador no soporta el formato de video.
    </video>

    {/* Capa de oscurecimiento general para el video */}
    <div class="absolute inset-0 bg-black/50"></div>

    {/* Degradados superior e inferior reforzados */}
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/30 to-background"
    >
    </div>
  </div>

  {/* 2. CONTENIDO PRINCIPAL */}
  <div
    class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 pt-16 text-center"
  >
    {/* Aumentado a max-w-6xl para dar amplitud horizontal */}
    <div class="max-w-6xl mx-auto space-y-5 sm:space-y-6">
      {/* BADGE ELEGANTE */}
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-black/50 border border-white/20 backdrop-blur-md text-primary font-heading text-xs sm:text-sm tracking-[2px] shadow-lg"
      >
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="text-white">{t["hero.badge"]}</span>
      </div>

      {/* TÍTULO IMPACTANTE CON ALTURA DE LÍNEA AJUSTADA */}
      <h1
        class="font-heading text-5xl sm:text-7xl md:text-8xl lg:text-[96px] tracking-wider text-white leading-[0.88] uppercase drop-shadow-[0_4px_25px_rgba(0,0,0,0.9)]"
      >
        <span class="block text-white/95">{t["hero.titleLine1"]}</span>
        <span
          class="block text-primary drop-shadow-[0_2px_15px_rgba(12,179,219,0.4)]"
        >
          {t["hero.titleLine2"]}
        </span>
      </h1>

      {/* SUBTÍTULO CON MÁS ANCHO PARA EXPANDIR EN 2-3 LÍNEAS MÁXIMO */}
      <p
        class="font-body text-white/90 text-base sm:text-lg md:text-xl max-w-3xl mx-auto leading-relaxed font-normal drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]"
      >
        {t["hero.subtitle"]}
      </p>

      {/* BOTONES DE ACCIÓN */}
      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4"
      >
        <a
          href={`/${currentLang}/programs`}
          class="w-full sm:w-auto bg-primary hover:bg-primary/90 text-primary-foreground font-heading tracking-widest text-base sm:text-lg px-8 py-3.5 rounded-lg transition-all transform hover:-translate-y-0.5 shadow-xl shadow-primary/30 flex items-center justify-center gap-2 group cursor-pointer"
        >
          <span>{t["hero.btnPrimary"]}</span>
          <svg
            class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>

        <a
          href={`/${currentLang}/pricing`}
          class="w-full sm:w-auto bg-black/50 hover:bg-black/70 text-white border border-white/30 hover:border-white font-heading tracking-widest text-base sm:text-lg px-8 py-3.5 rounded-lg backdrop-blur-md transition-all flex items-center justify-center cursor-pointer"
        >
          {t["hero.btnSecondary"]}
        </a>
      </div>
    </div>
  </div>
</section>