---
const currentLang = Astro.currentLocale || "es";

const heroData = {
  bgTitle: "BRASIL",
  title: "Tu Puerta a la Aventura en Perú",
  description:
    "Descubre la majestuosidad de Machu Picchu con nuestra agencia. Te ofrecemos visitas guiadas, rutas de trekking y experiencias auténticas para que vivas la historia inca de manera inolvidable.",
  btnPrimary: "Reservar ahora",
  btnSecondary: "Ver experiencias",
  previewCounter: "01/10",
};
---

<section
  class="relative min-h-screen w-full overflow-hidden bg-zinc-950 flex flex-col justify-between"
>
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1483729558449-99ef09a8c325?q=80&w=2070&auto=format&fit=crop"
      alt="Fondo Brasil Rio de Janeiro"
      class="h-full w-full object-cover object-center brightness-90 contrast-105"
    />
    <div
      class="absolute inset-0 bg-linear-to-b from-black/60 via-transparent to-black/90"
    >
    </div>
  </div>

  <!-- INFERIOR: TEXTO DE BIENVENIDA Y TARJETA PREVIEW -->
  <div
    class="relative z-20 w-full px-4 sm:px-6 lg:px-8 pb-10 md:pb-14 flex flex-col md:flex-row items-end justify-between gap-8 mt-auto"
  >
    <!-- Lado Izquierdo: Título, Descripción y Botones -->
    <div class="max-w-xl space-y-5">
      <h2
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.15] drop-shadow-md"
      >
        {heroData.title}
      </h2>

      <p
        class="text-base sm:text-lg text-gray-200 font-normal leading-relaxed max-w-lg drop-shadow-sm"
      >
        {heroData.description}
      </p>

      <!-- Botones de Acción -->
      <div class="pt-2 flex flex-wrap items-center gap-4">
        <a
          href={`/${currentLang}/programs`}
          class="inline-flex items-center justify-center gap-2.5 bg-white text-black font-bold px-7 py-3.5 rounded-full hover:bg-gray-100 transition-all text-base shadow-xl hover:scale-105 active:scale-95"
        >
          <span>{heroData.btnPrimary}</span>
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>

        <a
          href={`/${currentLang}/results`}
          class="inline-flex items-center text-base font-semibold text-white hover:text-gray-200 transition px-5 py-3.5 rounded-full hover:bg-white/10 border border-transparent hover:border-white/20 backdrop-blur-sm"
        >
          {heroData.btnSecondary}
        </a>
      </div>
    </div>

    <!-- Lado Derecho: Tarjeta Preview estilo Galería/Slider -->
    <div class="w-full md:w-auto flex justify-end">
      <div
        class="relative w-full max-w-[280px] sm:max-w-[320px] aspect-[16/10] rounded-2xl overflow-hidden border border-white/25 bg-black/50 backdrop-blur-md p-2 shadow-2xl group cursor-pointer transition duration-300 hover:scale-105 hover:border-white/40"
      >
        <img
          src="https://images.unsplash.com/photo-1516306580123-e6e52b1b7b5f?q=80&w=800&auto=format&fit=crop"
          alt="Vista previa de lugar"
          class="w-full h-full object-cover rounded-xl brightness-90 group-hover:scale-110 transition duration-500"
        />

        <div
          class="absolute inset-0 p-4 flex flex-col justify-end bg-gradient-to-t from-black/80 via-transparent to-transparent rounded-2xl"
        >
          <div
            class="flex items-center justify-between text-xs text-white/90 font-semibold tracking-wider"
          >
            <span>{heroData.previewCounter}</span>

            <div
              class="w-28 h-1.5 bg-white/30 rounded-full overflow-hidden backdrop-blur-sm"
            >
              <div class="w-1/3 h-full bg-white rounded-full"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
