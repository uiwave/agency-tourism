---
const currentLang = Astro.currentLocale || "es";

const destinationsData = {
  badge: "DESTINOS POPULARES",
  title: "Los rincones más espectaculares de Brasil",
  description: "Selecciona tu próximo destino y descubre itinerarios diseñados para vivir experiencias inolvidables.",
  destinations: [
    {
      id: "rio",
      title: "Río de Janeiro",
      tagline: "Maravilla entre mar y montañas",
      category: "Cultura & Playas",
      duration: "3 a 7 días",
      image: "https://images.unsplash.com/photo-1483729558449-99ef09a8c325?q=80&w=1000&auto=format&fit=crop",
      isPopular: true
    },
    {
      id: "buzios",
      title: "Búzios & Arraial",
      tagline: "El Caribe brasileño de aguas cristalinas",
      category: "Relax & Costa",
      duration: "4 a 5 días",
      image: "https://images.unsplash.com/photo-1516306580123-e6e52b1b7b5f?q=80&w=1000&auto=format&fit=crop",
      isPopular: false
    },
    {
      id: "floripa",
      title: "Florianópolis",
      tagline: "Isla de la magia, surf y naturaleza",
      category: "Aventura & Vida Nocturna",
      duration: "5 a 8 días",
      image: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=1000&auto=format&fit=crop",
      isPopular: false
    },
    {
      id: "nordeste",
      title: "Salvador & Bahía",
      tagline: "Historia, saudades y tradición africana",
      category: "Patrimonio & Gastronomía",
      duration: "4 a 6 días",
      image: "https://images.unsplash.com/photo-1583200402127-1014e7a8581e?q=80&w=1000&auto=format&fit=crop",
      isPopular: true
    }
  ]
};
---

<section class="relative w-full py-20 lg:py-28 px-4 sm:px-6 lg:px-8 bg-zinc-950 text-white select-none">
  <div class="max-w-7xl mx-auto space-y-16">
    
    <!-- ENCABEZADO -->
    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-bold tracking-widest uppercase text-white/90">
        <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
        {destinationsData.badge}
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.15] drop-shadow-md">
        {destinationsData.title}
      </h2>

      <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed drop-shadow-sm max-w-2xl">
        {destinationsData.description}
      </p>
    </div>

    <!-- TARJETAS DE DESTINOS (GRID 2x2 en pantallas medianas / grandes) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        destinationsData.destinations.map((destination) => (
          <a
            href={`/${currentLang}/programs?destination=${destination.id}`}
            class="group relative h-[420px] sm:h-[480px] w-full rounded-3xl overflow-hidden border border-white/20 shadow-2xl flex flex-col justify-between p-6 sm:p-8 transition-all duration-500 hover:scale-[1.01] hover:border-white/40"
          >
            <!-- Imagen de fondo con Zoom al hacer Hover -->
            <img 
              src={destination.image} 
              alt={destination.title} 
              class="absolute inset-0 w-full h-full object-cover object-center brightness-90 group-hover:scale-110 transition-transform duration-700 ease-out z-0"
            />

            <!-- Capa Gradiente para asegurar lectura perfecta -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/30 z-10"></div>

            <!-- PARTE SUPERIOR DE LA TARJETA: Badges -->
            <div class="relative z-20 flex items-center justify-between gap-2">
              <span class="px-3.5 py-1.5 rounded-full bg-black/40 backdrop-blur-md border border-white/20 text-xs font-semibold text-white/90">
                {destination.category}
              </span>

              {destination.isPopular && (
                <span class="px-3.5 py-1.5 rounded-full bg-white text-black font-bold text-xs shadow-lg">
                  Popular
                </span>
              )}
            </div>

            <!-- PARTE INFERIOR DE LA TARJETA: Información y Acción -->
            <div class="relative z-20 space-y-4">
              <div class="space-y-1">
                <span class="text-xs font-semibold tracking-wider text-teal-300 uppercase">
                  Recomendado: {destination.duration}
                </span>
                <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight drop-shadow">
                  {destination.title}
                </h3>
                <p class="text-sm sm:text-base text-gray-200 font-normal drop-shadow-sm">
                  {destination.tagline}
                </p>
              </div>

              <!-- Botón flotante al hacer Hover -->
              <div class="pt-2 flex items-center gap-2 text-sm font-bold text-white group-hover:translate-x-1 transition-transform duration-300">
                <span>Explorar tours</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </div>
            </div>

          </a>
        ))
      }
    </div>

  </div>
</section>