---
import { destinations } from "@/data/destinations";
import { getTranslations } from "@/i18n";
import SectionHeading from "@/components/SectionHeading.astro";
import DestinationCard from "@/components/DestinationCard.astro";

const currentLang = Astro.currentLocale || "es";
const t = getTranslations(currentLang);
---

<section class="w-full overflow-hidden">
  <div class="uw-container">
    <div class="mb-8 sm:mb-12">
      <SectionHeading
        title={t["destinations.badge"]}
        subtitle={t["destinations.description"]}
      />
    </div>
    <div class="flex flex-col md:flex-row gap-4 h-150 md:h-130 w-full">
      {
        destinations.map((item) => (
          <DestinationCard
            name={item.name}
            slug={item.slug}
            description={item.description}
            image={item.image}
            lang={currentLang}
          />
        ))
      }
    </div>
  </div>
</section>
