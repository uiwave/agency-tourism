---
import { destinations } from "@/data/destinations";
import { getTranslations } from "@/i18n";

const currentLang = Astro.currentLocale || "es";
const t = getTranslations(currentLang);
---

<section class="uw-section overflow-hidden">
  <div class="uw-container">
    <div class="text-center mb-8 md:mb-14">
      <h2 class="uw-heading-sm text-white mb-4">
        {t["destinations.badge"]}
      </h2>
      <p class="font-body text-foreground/70 max-w-2xl mx-auto">
        {t["destinations.description"]}
      </p>
    </div>
    <div class="flex flex-col md:flex-row gap-4 h-150 md:h-130 w-full">
      {
        destinations.map((item) => (
          <a
            href={currentLang === "es" ? `/tours?destination=${item.slug}` : `/${currentLang}/tours?destination=${item.slug}`}
            class="group relative flex-1 md:hover:flex-4 transition-all duration-500 ease-in-out overflow-hidden shrink-0"
          >
            <img
              class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              src={item.image}
              alt={item.name[currentLang]}
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent group-hover:via-black/60 transition-all duration-500" />

            <div class="md:hidden absolute inset-x-0 bottom-0 bg-black/60 backdrop-blur-xs p-4 flex items-center justify-between z-10 transition-all duration-300 group-hover:opacity-0 group-hover:pointer-events-none">
              <span class="font-heading text-xl tracking-wide text-white truncate pr-2">
                {item.name[currentLang]}
              </span>
            </div>

            <div class="hidden md:flex absolute inset-y-0 left-0 w-20 bg-black/60 backdrop-blur-xs items-center justify-center p-4 z-10 transition-all duration-300 group-hover:opacity-0 group-hover:pointer-events-none select-none">
              <span class="font-heading text-xl text-white tracking-wider uppercase [writing-mode:vertical-rl] rotate-180 whitespace-nowrap drop-shadow-md">
                {item.name[currentLang]}
              </span>
            </div>

            <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 text-white z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-75">
              <h3 class="font-heading text-xl sm:text-2xl tracking-wide">
                {item.name[currentLang]}
              </h3>

              <p class="font-body text-sm text-white/70 mt-2 line-clamp-2 md:line-clamp-3">
                {item.description[currentLang]}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
