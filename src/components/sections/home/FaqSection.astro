---
const currentLang = Astro.currentLocale || "es";

const faqData = {
  badge: "RESOLVEMOS TUS DUDAS",
  title: "Preguntas Frecuentes",
  description: "Todo lo que necesitas saber antes de planificar tu viaje y reservar con nosotros.",
  faqs: [
    {
      question: "¿Cuáles son las formas de pago disponibles?",
      answer: "Aceptamos tarjetas de crédito/débito internacionales, transferencias bancarias y pagos en cuotas según el país de origen. También ofrecemos opciones de pago anticipado con descuentos especiales."
    },
    {
      question: "¿Los paquetes incluyen pasajes aéreos?",
      answer: "Nuestros paquetes estándar incluyen hospedaje, traslados, excursiones y asistencia personalizada. Los pasajes aéreos se pueden coordinar y cotizar por separado con nuestros asesores para ajustarse a tus fechas."
    },
    {
      question: "¿Qué documentación necesito para viajar a Brasil?",
      answer: "Para la mayoría de los países de América del Sur, solo necesitas tu Documento Nacional de Identidad (DNI) o Pasaporte vigente. Para otros países se puede requerir visado o certificado de vacunación contra la fiebre amarilla según la región."
    },
    {
      question: "¿Puedo personalizar un itinerario a la medida?",
      answer: "¡Por supuesto! Diseñamos viajes 100% personalizados. Puedes cambiar noches de estancia, agregar excursiones exclusivas o combinar varios destinos en un solo itinerario."
    },
    {
      question: "¿Qué sucede si necesito cancelar o reprogramar mi viaje?",
      answer: "Contamos con políticas de flexibilidad. Puedes cancelar o reprogramar tu fecha sin penalizaciones sujetas a nuestras condiciones generales y con aviso previo de al menos 15 días."
    },
    {
      question: "¿Ofrecen asistencia médica en viaje?",
      answer: "Sí, todos nuestros itinerarios recomendados incluyen o permiten adicionar cobertura de seguro de viaje con atención médica las 24 horas durante toda tu estadía."
    }
  ]
};
---

<section class="relative w-full py-20 lg:py-28 px-4 sm:px-6 lg:px-8 bg-zinc-950 text-white select-none">
  <div class="max-w-7xl mx-auto space-y-16">
    
    <!-- ENCABEZADO -->
    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-bold tracking-widest uppercase text-white/90">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        {faqData.badge}
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.15] drop-shadow-md">
        {faqData.title}
      </h2>

      <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed drop-shadow-sm max-w-2xl">
        {faqData.description}
      </p>
    </div>

    <!-- LISTA DE PREGUNTAS FRECUENTES (DESPLEGABLES) -->
    <div class="max-w-4xl space-y-4">
      {
        faqData.faqs.map((faq) => (
          <details class="group rounded-3xl bg-black/40 backdrop-blur-md border border-white/15 p-6 sm:p-8 transition-all duration-300 hover:border-white/30 [&[open]]:bg-black/60 [&[open]]:border-white/40">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none select-none">
              <span class="text-lg sm:text-xl font-bold text-white group-hover:text-amber-300 transition-colors">
                {faq.question}
              </span>
              <div class="w-10 h-10 rounded-full bg-white/10 border border-white/20 flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform duration-300">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </summary>
            
            <p class="mt-4 text-sm sm:text-base text-gray-300 font-normal leading-relaxed border-t border-white/10 pt-4">
              {faq.answer}
            </p>
          </details>
        ))
      }
    </div>

  </div>
</section>