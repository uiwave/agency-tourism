---
const currentLang = Astro.currentLocale || "es";

const contactData = {
  badge: "ATENCIÓN PERSONALIZADA",
  title: "Estamos listos para planificar tu viaje soñado",
  description: "Escríbenos y uno de nuestros asesores expertos se pondrá en contacto contigo en menos de 24 horas.",
  channels: [
    {
      title: "Atención por WhatsApp",
      value: "+55 21 99999-9999",
      href: "https://wa.me/5521999999999",
      actionText: "Chat directo",
      icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
    },
    {
      title: "Correo Electrónico",
      value: "contacto@tuempresa.com",
      href: "mailto:contacto@tuempresa.com",
      actionText: "Enviar correo",
      icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
    },
    {
      title: "Oficina Central",
      value: "Av. Atlântica, Copacabana - Rio de Janeiro, Brasil",
      href: "#",
      actionText: "Ver ubicación",
      icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
    }
  ]
};
---

<section class="relative w-full py-20 lg:py-28 px-4 sm:px-6 lg:px-8 bg-zinc-950 text-white select-none">
  <div class="max-w-7xl mx-auto space-y-16">
    
    <!-- ENCABEZADO -->
    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-bold tracking-widest uppercase text-white/90">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {contactData.badge}
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.15] drop-shadow-md">
        {contactData.title}
      </h2>

      <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed drop-shadow-sm max-w-2xl">
        {contactData.description}
      </p>
    </div>

    <!-- CONTENIDO PRINCIPAL: CANALES Y FORMULARIO -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LADO IZQUIERDO: CANALES DE CONTACTO (4 columnas) -->
      <div class="lg:col-span-5 space-y-6">
        {
          contactData.channels.map((channel) => (
            <div class="p-6 sm:p-8 rounded-3xl bg-black/40 backdrop-blur-md border border-white/15 shadow-xl flex flex-col justify-between space-y-4 group hover:border-white/30 transition duration-300">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-white group-hover:bg-white group-hover:text-black transition duration-300 shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={channel.icon}></path>
                  </svg>
                </div>
                <div class="space-y-0.5">
                  <h3 class="text-base font-bold text-white">{channel.title}</h3>
                  <p class="text-xs sm:text-sm text-gray-300 font-medium leading-relaxed">{channel.value}</p>
                </div>
              </div>

              {channel.href !== "#" && (
                <div class="pt-2 border-t border-white/10">
                  <a 
                    href={channel.href} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center gap-2 text-xs font-bold text-white/80 hover:text-white transition-colors"
                  >
                    <span>{channel.actionText}</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                  </a>
                </div>
              )}
            </div>
          ))
        }
      </div>

      <!-- LADO DERECHO: FORMULARIO DE CONTACTO (7 columnas) -->
      <div class="lg:col-span-7 p-8 sm:p-10 rounded-3xl bg-black/50 backdrop-blur-xl border border-white/20 shadow-2xl space-y-6">
        <h3 class="text-2xl font-bold text-white tracking-tight">Mándanos un mensaje</h3>
        
        <form class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Nombre -->
            <div class="space-y-2">
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-gray-300">Nombre completo</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                placeholder="Ej. María García" 
                required
                class="w-full px-5 py-3.5 rounded-2xl bg-white/5 border border-white/15 text-white placeholder-gray-500 text-sm focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition"
              />
            </div>

            <!-- Email -->
            <div class="space-y-2">
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-gray-300">Correo electrónico</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="tu@email.com" 
                required
                class="w-full px-5 py-3.5 rounded-2xl bg-white/5 border border-white/15 text-white placeholder-gray-500 text-sm focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Teléfono / WhatsApp -->
            <div class="space-y-2">
              <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-gray-300">Teléfono / WhatsApp</label>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                placeholder="+54 9 11 1234-5678" 
                class="w-full px-5 py-3.5 rounded-2xl bg-white/5 border border-white/15 text-white placeholder-gray-500 text-sm focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition"
              />
            </div>

            <!-- Destino o Interés -->
            <div class="space-y-2">
              <label for="destination" class="block text-xs font-bold uppercase tracking-wider text-gray-300">Destino de interés</label>
              <select 
                id="destination" 
                name="destination"
                class="w-full px-5 py-3.5 rounded-2xl bg-zinc-900 border border-white/15 text-white text-sm focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition cursor-pointer"
              >
                <option value="rio">Río de Janeiro</option>
                <option value="buzios">Búzios & Arraial do Cabo</option>
                <option value="floripa">Florianópolis</option>
                <option value="nordeste">Salvador & Nordeste</option>
                <option value="custom">Itinerario personalizado</option>
              </select>
            </div>
          </div>

          <!-- Mensaje -->
          <div class="space-y-2">
            <label for="message" class="block text-xs font-bold uppercase tracking-wider text-gray-300">Mensaje o detalles de tu viaje</label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              placeholder="¿Cuántas personas viajan? ¿Fechas estimadas?" 
              required
              class="w-full px-5 py-3.5 rounded-2xl bg-white/5 border border-white/15 text-white placeholder-gray-500 text-sm focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition resize-none"
            ></textarea>
          </div>

          <!-- Botón Enviar -->
          <button 
            type="submit" 
            class="w-full inline-flex items-center justify-center gap-2.5 bg-white text-black font-bold px-8 py-4 rounded-full hover:bg-gray-100 transition-all text-base shadow-xl hover:scale-[1.01] active:scale-95 cursor-pointer"
          >
            <span>Enviar mensaje</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </form>
      </div>

    </div>

  </div>
</section>