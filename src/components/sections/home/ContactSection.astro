---
import { getTranslations } from "@/i18n";

const currentLang = Astro.currentLocale || "es";

const t = getTranslations(currentLang);
---

<section class="w-full py-16 sm:py-24 bg-background text-foreground">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <!-- ENCABEZADO -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface border border-border text-primary font-heading text-xs sm:text-sm tracking-[2px]">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="text-white font-semibold">{t["contact.badge"]}</span>
      </div>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl text-white tracking-wider uppercase leading-tight font-bold">
        {t["contact.title"]}
      </h2>
      <p class="font-body text-white/70 text-base sm:text-lg leading-relaxed">
        {t["contact.subtitle"]}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12">

      <!-- FORMULARIO (3 columnas) -->
      <div class="lg:col-span-3 p-6 sm:p-8 rounded-2xl bg-card border border-border/50">
        <form class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="font-heading text-xs sm:text-sm text-white/80 tracking-wider uppercase">{t["contact.formName"]}</label>
              <input type="text" class="w-full px-4 py-3 rounded-xl bg-surface border border-border text-white font-body text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" />
            </div>
            <div class="space-y-2">
              <label class="font-heading text-xs sm:text-sm text-white/80 tracking-wider uppercase">{t["contact.formEmail"]}</label>
              <input type="email" class="w-full px-4 py-3 rounded-xl bg-surface border border-border text-white font-body text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" />
            </div>
          </div>
          <div class="space-y-2">
            <label class="font-heading text-xs sm:text-sm text-white/80 tracking-wider uppercase">{t["contact.formMessage"]}</label>
            <textarea rows="5" class="w-full px-4 py-3 rounded-xl bg-surface border border-border text-white font-body text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors resize-none"></textarea>
          </div>
          <button type="submit" class="w-full sm:w-auto bg-primary hover:bg-primary/90 text-primary-foreground font-heading text-sm font-bold tracking-wider px-8 py-3.5 rounded-xl transition-all duration-300 shadow-lg shadow-primary/30 cursor-pointer">
            {t["contact.formSubmit"]}
          </button>
        </form>
      </div>

      <!-- INFO DE CONTACTO (2 columnas) -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Teléfono -->
        <div class="flex items-start gap-4 p-5 rounded-2xl bg-card border border-border/50">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading text-sm text-white/60 tracking-wider uppercase">{t["contact.infoPhone"]}</h3>
            <p class="font-body text-white text-base font-semibold mt-1">+51 123 456 789</p>
          </div>
        </div>

        <!-- Email -->
        <div class="flex items-start gap-4 p-5 rounded-2xl bg-card border border-border/50">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading text-sm text-white/60 tracking-wider uppercase">{t["contact.infoEmail"]}</h3>
            <p class="font-body text-white text-base font-semibold mt-1">reservas@travelik.com</p>
          </div>
        </div>

        <!-- Dirección -->
        <div class="flex items-start gap-4 p-5 rounded-2xl bg-card border border-border/50">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading text-sm text-white/60 tracking-wider uppercase">{t["contact.infoAddress"]}</h3>
            <p class="font-body text-white text-base font-semibold mt-1">{t["header.address"]}</p>
          </div>
        </div>

        <!-- Horario -->
        <div class="flex items-start gap-4 p-5 rounded-2xl bg-card border border-border/50">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading text-sm text-white/60 tracking-wider uppercase">{t["contact.infoHours"]}</h3>
            <p class="font-body text-white text-base font-semibold mt-1">{t["header.hours"]}</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
