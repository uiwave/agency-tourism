---
import { getTranslations } from "@/i18n";
import SectionHeading from "@/components/SectionHeading.astro";

const currentLang = Astro.currentLocale || "es";

const t = getTranslations(currentLang);

const faqs = [
  { question: t["faq.item1Question"], answer: t["faq.item1Answer"] },
  { question: t["faq.item2Question"], answer: t["faq.item2Answer"] },
  { question: t["faq.item3Question"], answer: t["faq.item3Answer"] },
  { question: t["faq.item4Question"], answer: t["faq.item4Answer"] },
  { question: t["faq.item5Question"], answer: t["faq.item5Answer"] },
  { question: t["faq.item6Question"], answer: t["faq.item6Answer"] },
];
---

<section class="w-full py-16 sm:py-24 bg-surface/30 text-foreground">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16 items-start">

      <!-- FAQ ACCORDION (2 columnas) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="font-heading text-base sm:text-lg text-white tracking-[3px] uppercase mb-6">
          {t["faq.title"]}
        </h3>
        {
          faqs.map((faq, index) => (
            <div class:list={[
              "faq-item rounded-xl overflow-hidden transition-all duration-300",
              index === 0 ? "bg-card border border-primary/20" : "bg-card/50 border border-border/30 hover:border-primary/20"
            ]}>
              <button
                class="faq-toggle w-full flex items-center gap-4 p-5 text-left cursor-pointer"
                data-index={index}
              >
                <span class="font-heading text-sm text-primary/70 tracking-wider shrink-0">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="font-body text-sm sm:text-base text-white/90 font-medium leading-snug flex-1 pr-2">
                  {faq.question}
                </span>
                <svg class:list={[
                  "faq-icon w-5 h-5 shrink-0 transition-transform duration-300",
                  index === 0 ? "text-primary rotate-180" : "text-white/40"
                ]} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class:list={[
                "faq-answer px-5 pb-5",
                index === 0 ? "" : "hidden"
              ]}>
                <div class="ml-9 pl-4 border-l-2 border-primary/20">
                  <p class="font-body text-sm text-white/50 leading-relaxed">{faq.answer}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- FORMULARIO (3 columnas) -->
      <div class="lg:col-span-3">
        <div class="p-6 sm:p-8 lg:p-10 rounded-2xl bg-card border border-border/30">
          <SectionHeading
            badge={t["contact.badge"]}
            title={t["contact.title"]}
            subtitle={t["contact.subtitle"]}
            centered={false}
            class="mb-8"
          />

          <form class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="relative">
                <input
                  type="text"
                  id="name"
                  placeholder=" "
                  class="peer w-full px-4 pt-6 pb-2 rounded-xl bg-surface border border-border text-white font-body text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                />
                <label for="name" class="absolute left-4 top-1/2 -translate-y-1/2 font-heading text-xs text-white/40 tracking-wider uppercase pointer-events-none transition-all duration-200 peer-focus:top-2.5 peer-focus:text-[10px] peer-focus:text-primary peer-[:not(:placeholder-shown)]:top-2.5 peer-[:not(:placeholder-shown)]:text-[10px] peer-[:not(:placeholder-shown)]:text-white/60">
                  {t["contact.formName"]}
                </label>
              </div>
              <div class="relative">
                <input
                  type="email"
                  id="email"
                  placeholder=" "
                  class="peer w-full px-4 pt-6 pb-2 rounded-xl bg-surface border border-border text-white font-body text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                />
                <label for="email" class="absolute left-4 top-1/2 -translate-y-1/2 font-heading text-xs text-white/40 tracking-wider uppercase pointer-events-none transition-all duration-200 peer-focus:top-2.5 peer-focus:text-[10px] peer-focus:text-primary peer-[:not(:placeholder-shown)]:top-2.5 peer-[:not(:placeholder-shown)]:text-[10px] peer-[:not(:placeholder-shown)]:text-white/60">
                  {t["contact.formEmail"]}
                </label>
              </div>
            </div>
            <div class="relative">
              <textarea
                id="message"
                rows="4"
                placeholder=" "
                class="peer w-full px-4 pt-6 pb-2 rounded-xl bg-surface border border-border text-white font-body text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all resize-none"
              ></textarea>
              <label for="message" class="absolute left-4 top-6 font-heading text-xs text-white/40 tracking-wider uppercase pointer-events-none transition-all duration-200 peer-focus:top-2.5 peer-focus:text-[10px] peer-focus:text-primary peer-[:not(:placeholder-shown)]:top-2.5 peer-[:not(:placeholder-shown)]:text-[10px] peer-[:not(:placeholder-shown)]:text-white/60">
                {t["contact.formMessage"]}
              </label>
            </div>
            <button type="submit" class="w-full sm:w-auto bg-gradient-to-r from-primary to-primary/80 hover:from-primary/90 hover:to-primary/70 text-primary-foreground font-heading text-sm font-bold tracking-[2px] px-10 py-4 rounded-xl transition-all duration-300 shadow-lg shadow-primary/20 hover:shadow-primary/30 hover:-translate-y-0.5 cursor-pointer">
              {t["contact.formSubmit"]}
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggles = document.querySelectorAll(".faq-toggle");

    toggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const item = toggle.closest(".faq-item");
        const answer = item?.querySelector(".faq-answer");
        const icon = toggle.querySelector(".faq-icon");

        document.querySelectorAll(".faq-item").forEach((otherItem) => {
          if (otherItem !== item) {
            otherItem.querySelector(".faq-answer")?.classList.add("hidden");
            const otherIcon = otherItem.querySelector(".faq-icon");
            otherIcon?.classList.remove("rotate-180");
            otherIcon?.classList.add("text-white/40");
            otherIcon?.classList.remove("text-primary");
            otherItem.classList.remove("border-primary/20");
            otherItem.classList.add("border-border/30");
          }
        });

        answer?.classList.toggle("hidden");
        icon?.classList.toggle("rotate-180");
        icon?.classList.toggle("text-white/40");
        icon?.classList.toggle("text-primary");
        item?.classList.toggle("border-primary/20");
        item?.classList.toggle("border-border/30");
      });
    });
  });
</script>
