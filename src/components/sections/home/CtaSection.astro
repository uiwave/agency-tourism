---
import { getTranslations } from "@/i18n";
import SectionHeading from "@/components/SectionHeading.astro";

const currentLang = Astro.currentLocale || "es";

const t = getTranslations(currentLang);
---

<section class="relative w-full overflow-hidden">
  <div class="relative z-10 uw-container uw-section pb-0">
    <div class="max-w-4xl mx-auto text-center space-y-8">
      <SectionHeading title={t["cta.title"]} subtitle={t["cta.description"]} />
      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4"
      >
        <a
          href={`/${currentLang}/tours`}
          class="w-full sm:w-auto bg-primary hover:bg-primary/90 text-primary-foreground font-heading tracking-widest text-sm sm:text-base px-8 py-3.5 rounded-xl transition-all duration-300 shadow-xl shadow-primary/30 flex items-center justify-center gap-2"
        >
          <span>{t["cta.btnPrimary"]}</span>
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>

        <a
          href={`/${currentLang}/contact`}
          class="w-full sm:w-auto bg-black/50 hover:bg-black/70 text-white border border-white/30 hover:border-white font-heading tracking-widest text-sm sm:text-base px-8 py-3.5 rounded-xl backdrop-blur-md transition-all duration-300 flex items-center justify-center"
        >
          {t["cta.btnSecondary"]}
        </a>
      </div>
    </div>
  </div>
</section>
