---
const currentLang = Astro.currentLocale || "es";

const ctaData = {
  subtitle: "TU PRÓXIMA AVENTURA",
  title: "¿Listo para vivir una experiencia inolvidable en Brasil?",
  description: "Reserva hoy tu viaje y accede a guías personalizados, itinerarios exclusivos y atención las 24 horas durante toda tu estadía.",
  btnPrimary: "Comenzar mi reserva",
  btnSecondary: "Hablar con un asesor"
};
---

<section class="relative w-full py-20 lg:py-28 px-4 sm:px-6 lg:px-8 bg-zinc-950 overflow-hidden text-white select-none">
  
  <!-- Contenedor con Tarjeta Flotante y Fondo de Imagen con Filtro -->
  <div class="relative max-w-7xl mx-auto rounded-3xl overflow-hidden border border-white/20 shadow-2xl bg-zinc-900">
    
    <!-- Imagen de fondo con overlay oscuro -->
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.unsplash.com/photo-1516306580123-e6e52b1b7b5f?q=80&w=2070&auto=format&fit=crop" 
        alt="Fondo CTA Brasil" 
        class="w-full h-full object-cover object-center brightness-75 contrast-105"
      />
      <!-- Gradientes para asegurar lectura clara del texto -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/75 to-black/50"></div>
    </div>

    <!-- Contenido CTA -->
    <div class="relative z-10 px-6 py-16 sm:px-12 sm:py-20 lg:px-16 lg:py-24 max-w-3xl space-y-6">
      
      <!-- Subtítulo con estilo Pills/Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-bold tracking-widest uppercase text-white/90">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {ctaData.subtitle}
      </div>

      <!-- Título Principal -->
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.15] drop-shadow-md">
        {ctaData.title}
      </h2>

      <!-- Descripción legible -->
      <p class="text-base sm:text-lg text-gray-200 font-normal leading-relaxed drop-shadow-sm max-w-2xl">
        {ctaData.description}
      </p>

      <!-- Botones de Acción -->
      <div class="pt-4 flex flex-wrap items-center gap-4">
        <a 
          href={`/${currentLang}/contact`} 
          class="inline-flex items-center justify-center gap-2.5 bg-white text-black font-bold px-8 py-4 rounded-full hover:bg-gray-100 transition-all text-base shadow-xl hover:scale-105 active:scale-95 shrink-0"
        >
          <span>{ctaData.btnPrimary}</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>

        <a 
          href={`/${currentLang}/results`} 
          class="inline-flex items-center justify-center text-base font-semibold text-white hover:text-gray-200 transition px-6 py-4 rounded-full bg-black/40 hover:bg-white/15 border border-white/20 backdrop-blur-md shadow-lg"
        >
          {ctaData.btnSecondary}
        </a>
      </div>

    </div>

  </div>
</section>